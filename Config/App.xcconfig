PRODUCT_NAME = Telescope
PRODUCT_MODULE_NAME = DeskLink
EXECUTABLE_NAME = $(PRODUCT_NAME)
PRODUCT_BUNDLE_IDENTIFIER = local.nikey.desklink
CURRENT_PROJECT_VERSION = 195
MARKETING_VERSION = 0.1
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Telescope
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
DERIVE_MACCATALYST_PRODUCT_BUNDLE_IDENTIFIER = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
ENABLE_APP_SANDBOX = YES
ENABLE_OUTGOING_NETWORK_CONNECTIONS = YES
ENABLE_USER_SELECTED_FILES = readwrite
CODE_SIGN_STYLE = Automatic
DESKLINK_SIGN_STYLE = Automatic
CODE_SIGN_STYLE[sdk=iphoneos*] = $(DESKLINK_SIGN_STYLE)
DEVELOPMENT_TEAM[sdk=iphoneos*] = $(DESKLINK_TEAM)
CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] = Config/iOSKeychain.entitlements
#include "MacSigning.xcconfig"
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = $(DESKLINK_MAC_ENTITLEMENTS)
PROVISIONING_PROFILE_SPECIFIER[sdk=iphoneos*] = $(DESKLINK_PROFILE)
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
